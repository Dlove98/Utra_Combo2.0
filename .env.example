# Copiez ce fichier en .env.local (en local) et configurez les mêmes variables
# dans Vercel > Project Settings > Environment Variables (jamais dans le code).

# Clé API football-data.org (https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=votre_cle_ici

# Nombre de jours affichés dans la fenêtre d'analyse (aujourd'hui + N jours)
NEXT_PUBLIC_ANALYSIS_WINDOW_DAYS=3

# Nombre max de matchs éligibles pour l'onglet "Combinés du Jour"
NEXT_PUBLIC_MAX_COMBO_CANDIDATES=25
